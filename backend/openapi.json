  "components": {
    "schemas": {
      "ConsentRequest": {
        "properties": {
          "granted": {
            "type": "boolean",
            "title": "Granted"
          },
          "policy_version": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Policy Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "granted",
          "policy_version"
        ],
        "title": "ConsentRequest"
      },
      "CreateRecord": {
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Client Id"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_id",
          "payload"
        ],
        "title": "CreateRecord"
      },
      "DeleteAccount": {
        "properties": {
          "confirmation": {
            "type": "string",
            "const": "DELETE",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation"
        ],
        "title": "DeleteAccount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Payload": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "FOOD",
              "WATER",
              "ACTIVITY",
              "WEIGHT",
              "MOOD",
              "TASK",
              "SLEEP",
              "MEDICATION",
              "MEDICATION_EVENT",
              "FOCUS_SESSION",
              "MEAL_PLAN",
              "SHOPPING",
              "REPORT"
            ],
            "title": "Kind"
          },
          "at": {
            "type": "integer",
            "maximum": 4102444800000.0,
            "minimum": 0.0,
            "title": "At"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "title": "Title"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 30000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "energy": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 30000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Energy"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "title": "Source",
            "default": "User entered"
          },
          "source_version": {
            "type": "string",
            "maxLength": 100,
            "title": "Source Version",
            "default": "user-v1"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "at",
          "title"
        ],
        "title": "Payload"
      },
      "ReplaceRecord": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "payload": {
            "$ref": "#/components/schemas/Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "payload"
        ],
        "title": "ReplaceRecord"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
